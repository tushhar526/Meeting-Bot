# Microsoft Calendar Integration
MICROSOFT_CLIENT_ID=your_microsoft_app_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_app_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:5000/calendar/microsoft/callback
MICROSOFT_CLIENT_STATE=meetingbot-secret-change-this-in-production

# Google Calendar Integration
GOOGLE_CLIENT_ID=your_google_app_client_id
GOOGLE_CLIENT_SECRET=your_google_app_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/calendar/google/callback

# Zoom Integration
ZOOM_CLIENT_ID=your_zoom_app_client_id
ZOOM_CLIENT_SECRET=your_zoom_app_client_secret
ZOOM_REDIRECT_URI=http://localhost:5000/calendar/zoom/callback
ZOOM_SECRET_KEY=your_zoom_webhook_secret

# Database Configuration
SQLALCHEMY_DATABASE_URI=sqlite:///mydb.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key
SECRET_KEY=your_flask_secret_key
JWT_ACCESS_TOKEN_EXPIRES=1
JWT_REFRESH_TOKEN_EXPIRES=30
JWT_TOKEN_LOCATION=cookies
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=False

# Other Configuration
SQLALCHEMY_TRACK_MODIFICATIONS=False
